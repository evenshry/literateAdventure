{
  "name": "literate-adventure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-hanzi-data.mjs",
    "dev": "vite",
    "dev:deploy": "node scripts/copy-hanzi-data.mjs && vite --mode deploy",
    "prebuild": "node scripts/copy-hanzi-data.mjs",
    "build": "vite build",
    "predeploy": "node scripts/copy-hanzi-data.mjs",
    "deploy": "tsc -b && vite build --mode deploy",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "hanzi-writer": "^3.7.3",
    "hanzi-writer-data": "^2.0.1",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.30",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "sass": "^1.100.0",
    "typescript": "^6.0.3",
    "vite": "^5.0.8"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "yarn@4.16.0",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.scss": [
      "prettier --write"
    ]
  }
}
